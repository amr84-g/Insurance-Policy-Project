  <cards name="insurance-policy-cards" title="Insurance Policies"
    model="com.axelor.apps.insurance.policy.db.PolicyTable" width="32%">
    <field name="policyId"/>
    <field name="customer.simpleFullName"/>
    <field name="typeOfPolicy"/>
    <field name="insuranceType"/>
    <field name="sector"/>
    <field name="issueDate"/>
    <field name="effectiveDate"/>
    <field name="endDate"/>
    <field name="policyStatus"/>
    <field name="status"/>
    <template><![CDATA[
      <>
        <Box style={{ border: "1px solid #e2e8f0", borderRadius: 12, overflow: "hidden", backgroundColor: "#ffffff", boxShadow: "0 4px 14px rgba(15, 23, 42, 0.08)" }}>
          <Box style={{ height: 4, backgroundColor: policyStatus == 'active' ? "#16a34a" : policyStatus == 'cancelled' || policyStatus == 'expired' ? "#dc2626" : "#2563eb" }}/>
          <Box p={3}>
            <Box d="flex" justifyContent="between" alignItems="flex-start" mb={3}>
              <Box style={{ minWidth: 0 }}>
                <small style={{ color: "#64748b", textTransform: "uppercase", letterSpacing: "0.08em" }}>{_t('Insurance Policy')}</small>
                <h4 style={{ margin: "4px 0", color: "#0f172a" }}>{policyId || _t('Policy')}</h4>
                <Box style={{ color: "#475569", fontSize: 14 }}>{customer?.simpleFullName || _t('No customer')}</Box>
              </Box>
              <Box d="flex" flexDirection="column" gap={1} alignItems="flex-end">
                {policyStatus && <Badge bg={policyStatus == 'active' ? 'success' : policyStatus == 'cancelled' || policyStatus == 'expired' ? 'danger' : 'secondary'}>{policyStatus}</Badge>}
                {status && <Badge bg={status == 'paid' ? 'success' : status == 'unpaid' ? 'warning' : 'info'}>{status}</Badge>}
              </Box>
            </Box>
            <Box d="grid" gridTemplateColumns="1fr 1fr" gap={2} style={{ padding: 12, borderRadius: 8, backgroundColor: "#f8fafc" }}>
              <Box>
                <small style={{ color: "#64748b" }}>{_t('Type of Policy')}</small>
                <Box style={{ color: "#0f172a", fontWeight: 600 }}>{typeOfPolicy || '-'}</Box>
              </Box>
              <Box>
                <small style={{ color: "#64748b" }}>{_t('Insurance Type')}</small>
                <Box style={{ color: "#0f172a", fontWeight: 600 }}>{insuranceType || '-'}</Box>
              </Box>
              <Box>
                <small style={{ color: "#64748b" }}>{_t('Sector')}</small>
                <Box style={{ color: "#0f172a", fontWeight: 600 }}>{sector || '-'}</Box>
              </Box>
              <Box>
                <small style={{ color: "#64748b" }}>{_t('Issue Date')}</small>
                <Box style={{ color: "#0f172a" }}>{issueDate ? $moment(issueDate).format('YYYY-MM-DD') : '-'}</Box>
              </Box>
              <Box>
                <small style={{ color: "#64748b" }}>{_t('Effective Date')}</small>
                <Box style={{ color: "#0f172a" }}>{effectiveDate ? $moment(effectiveDate).format('YYYY-MM-DD') : '-'}</Box>
              </Box>
              <Box>
                <small style={{ color: "#64748b" }}>{_t('End Date')}</small>
                <Box style={{ color: "#0f172a" }}>{endDate ? $moment(endDate).format('YYYY-MM-DD') : '-'}</Box>
              </Box>
            </Box>
          </Box>
        </Box>
      </>
    ]]></template>
  </cards>

